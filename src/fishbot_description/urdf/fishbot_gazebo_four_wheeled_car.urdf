<?xml version="1.0"?>
<robot name="fishbot">


  <!-- Robot Footprint -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.076" rpy="0 0 0"/>
  </joint>


  <!-- base link -->
  <link name="base_link">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
  		<box size="0.60 0.52 0.12"/>
      </geometry>
      <material name="blue">
      	<color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		<box size="0.60 0.52 0.12"/>
      </geometry>
      <material name="blue">
      	<color rgba="0.1 0.1 1.0 0.5" /> 
      </material>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0122666" ixy="0" ixz="0" iyy="0.0122666" iyz="0" izz="0.02"/>
    </inertial>
  </link>
    
  <!-- laser link -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 0.5" /> 
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.02"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 0.5" /> 
      </material>
    </collision>
    <inertial>
    <mass value="0.1"/>
      <inertia ixx="0.000190416666667" ixy="0" ixz="0" iyy="0.0001904" iyz="0" izz="0.00036"/>
    </inertial>
  </link>
  
  <!-- laser joint -->
  <joint name="laser_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser_link" />
      <origin xyz="0.2375 0 0.075" />
  </joint>

  <link name="imu_link">
  	<visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		    <box size="0.02 0.02 0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
		    <box size="0.02 0.02 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
        <inertia ixx="0.000190416666667" ixy="0" ixz="0" iyy="0.0001904" iyz="0" izz="0.00036"/>
      </inertial>
  </link>

  <!-- imu joint -->
  <joint name="imu_joint" type="fixed">
      <parent link="base_link" />
      <child link="imu_link" />
      <origin xyz="0 0 0.02" />
  </joint>


  <!-- 四轮全向（四个独立转向 + 四个独立驱动） -->
  <!-- 参数：左右轮距 0.42m，前后轮距 0.45m，轮半径 0.06m，转向偏移 y=0 -->

  <!-- 前左转向电机（上层） -->
  <link name="front_left_steer_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.018"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 0.8" />
        </material>
      </visual>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
  </link>

  <joint name="front_left_steer_joint" type="revolute">
      <parent link="base_link" />
      <child link="front_left_steer_link" />
      <origin xyz="0.225 0.21 -0.016" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="1.5"/>
  </joint>

  <link name="front_left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.7" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
  </link>

  <joint name="front_left_wheel_joint" type="continuous">
      <parent link="front_left_steer_link" />
      <child link="front_left_wheel_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- 前右转向电机（上层） -->
  <link name="front_right_steer_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.018"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 0.8" />
        </material>
      </visual>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
  </link>

  <joint name="front_right_steer_joint" type="revolute">
      <parent link="base_link" />
      <child link="front_right_steer_link" />
      <origin xyz="0.225 -0.21 -0.016" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="1.5"/>
  </joint>

  <link name="front_right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.7" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
  </link>

  <joint name="front_right_wheel_joint" type="continuous">
      <parent link="front_right_steer_link" />
      <child link="front_right_wheel_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- 后左转向电机（上层） -->
  <link name="rear_left_steer_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.018"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 0.8" />
        </material>
      </visual>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
  </link>

  <joint name="rear_left_steer_joint" type="revolute">
      <parent link="base_link" />
      <child link="rear_left_steer_link" />
      <origin xyz="-0.225 0.21 -0.016" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="1.5"/>
  </joint>

  <link name="rear_left_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.7" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
  </link>

  <joint name="rear_left_wheel_joint" type="continuous">
      <parent link="rear_left_steer_link" />
      <child link="rear_left_wheel_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- 后右转向电机（上层） -->
  <link name="rear_right_steer_link">
      <visual>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.06" radius="0.018"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 0.8" />
        </material>
      </visual>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
  </link>

  <joint name="rear_right_steer_joint" type="revolute">
      <parent link="base_link" />
      <child link="rear_right_steer_link" />
      <origin xyz="-0.225 -0.21 -0.016" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-1.5708" upper="1.5708" effort="20.0" velocity="1.5"/>
  </joint>

  <link name="rear_right_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 0.7" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079 0 0"/>
        <geometry>
          <cylinder length="0.045" radius="0.06"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.25"/>
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0005"/>
      </inertial>
  </link>

  <joint name="rear_right_wheel_joint" type="continuous">
      <parent link="rear_right_steer_link" />
      <child link="rear_right_wheel_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
  </joint>

  <!-- 轮胎摩擦参数 -->
  <gazebo reference="front_left_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
    <kp value="1000000.0" />
    <kd value="10.0" />
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="front_right_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
    <kp value="1000000.0" />
    <kd value="10.0" />
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="rear_left_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
    <kp value="1000000.0" />
    <kd value="10.0" />
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="rear_right_wheel_link">
    <mu1 value="0.9"/>
    <mu2 value="0.9"/>
    <kp value="1000000.0" />
    <kd value="10.0" />
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- 发布轮组关节状态；四轮全向控制建议通过 ros2_control 配置 8 个关节 -->
  <gazebo>
    <plugin name='joint_state_publisher' filename='libgazebo_ros_joint_state_publisher.so'>
      <ros>
        <namespace>/</namespace>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>front_left_steer_joint</joint_name>
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_steer_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_steer_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_steer_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <ros2_control name="fishbot_four_wheel_system" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="front_left_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_steer_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/home/realman/workspace/fishbot/install/fishbot_description/share/fishbot_description/config/four_wheel_controllers.yaml</parameters>
    </plugin>
  </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
          <ros>
            <namespace>/</namespace>
            <remapping>~/out:=imu</remapping>
          </ros>
          <initial_orientation_as_reference>false</initial_orientation_as_reference>
        </plugin>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2e-4</stddev>
                <bias_mean>0.0000075</bias_mean>
                <bias_stddev>0.0000008</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>1.7e-2</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
    </gazebo>

  <!-- simple depth camera link -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 1.5708"/>
      <geometry>
        <!-- 长条盒子模拟相机 -->
        <box size="0.08 0.03 0.03"/>
      </geometry>
      <material name="gray">
        <color rgba="0.3 0.3 0.3 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.03 0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- camera joint：左前上方，朝前 -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <!-- x=前, y=左, z=上：不和雷达共线，就不会挡住扫描面 -->
    <origin xyz="0.255 0.0 0.03" rpy="0 0 0" />
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_link" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <gazebo reference="laser_link">
    <sensor name="laser_sensor" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <ray>
          <scan>
            <horizontal>
              <samples>2000</samples>
              <resolution>1.000000</resolution>
              <min_angle>0.000000</min_angle>
              <max_angle>6.280000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.120000</min>
            <max>30.0</max>
            <resolution>0.015000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
      </ray>

      <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================ Gazebo 上的相机 + 前向“深度扫描” ================ -->
  <gazebo reference="camera_link">

    <!-- RGBD 相机 -->
    <sensor name="rgbd_camera" type="depth">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <camera name="camera">
        <horizontal_fov>1.518</horizontal_fov>
        <image>
          <width>848</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.20</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>

      <plugin name="rgbd_camera_plugin" filename="libgazebo_ros_camera.so">
        <camera_name>rgbd_camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
        <hack_baseline>0.07</hack_baseline>
        <min_depth>0.20</min_depth>
        <max_depth>10.0</max_depth>
        <ros>
          <namespace>/camera</namespace>
          <remapping>image_raw:=image/image_raw</remapping>
          <remapping>image_depth:=depth/image_raw</remapping>
          <remapping>camera_info:=image/camera_info</remapping>
          <remapping>depth/camera_info:=depth/camera_info</remapping>
          <remapping>points:=depth/points</remapping>
        </ros>
      </plugin>
    </sensor>

  </gazebo>

</robot>